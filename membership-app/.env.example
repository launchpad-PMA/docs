# Copy to .env for a local steward machine. Do not commit .env.
# Leave AGREEMENT_PUBLICATION as draft until counsel approves a covenant version
# and that version's front matter says status: approved.

HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Long random value. Steward routes stay closed when this is empty.
ADMIN_TOKEN=

# draft | published
# published has no effect unless the covenant file also says status: approved.
AGREEMENT_PUBLICATION=draft

# Optional enhanced-benefit links. Empty means the dashboard shows the pathway
# and does not invent a URL. Foundational membership does not use these.
PATREON_URL_TEMPLE=https://www.patreon.com/c/templeofroots/membership
PATREON_URL_ADBUNGO=
HIPCAMP_URL=

# Optional NFT checks. The server calls eth_call balanceOf. It never receives a key.
# Leave blank until a steward has verified the collection address.
NFT_RPC_URL=
